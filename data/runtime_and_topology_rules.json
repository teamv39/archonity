  "topology_hub_exclusion_rationale": "Узлы Service Discovery (ts-eureka-service, ts-eureka-auth-server), централизованной конфигурации (ts-config-service), брокера сообщений (rabbitmq), распределенного трейсинга (zipkin) и центрального шлюза (ts-gateway-service) соединяются практически со всеми компонентами системы. Их включение в расчет HITS (hub/authority) и метрик направленной окрестности (co-citation, co-usage, 2-step reachability) создает ложные короткие замыкания между функционально не связанными микросервисами (ADR-003, п. 5.1). Они временно исключаются из графа при вычислении топологических фичей.",
  "hits_and_neighborhood_rules": {
    "hits_metrics": {
      "description": "Алгоритм HITS (nx.hits) выполняется на ориентированном графе скелета с исключенными хабовыми узлами",
      "features": [
        "hits_hub_u: склонность вызывающего микросервиса u выступать оркестратором сценариев",
        "hits_auth_v: авторитетность вызываемого сервиса v как поставщика доменных сущностей",
        "hits_product: произведение h(u) * a(v), оценивающее априорную вероятность клиент-серверной связи"
      ]
    },
    "directed_neighborhood_metrics": {
      "co_citation_jaccard": "Jaccard_succ(u, v) = |Succ(u) ∩ Succ(v)| / |Succ(u) ∪ Succ(v)| (общие исходящие цели / shared callees)",
      "co_usage_jaccard": "Jaccard_pred(u, v) = |Pred(u) ∩ Pred(v)| / |Pred(u) ∪ Pred(v)| (общие клиенты / shared callers)",
      "two_step_directed_reachability": "Проверка существования пути длины 2 (u -> w -> v) в DiGraph без хабов",
      "shortest_path_length": "Длина ориентированного кратчайшего пути с индикатором недостижимости (-1)"
    }
  },

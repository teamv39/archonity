{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "artifact_id": "branch_rules",
  "description": "Archonity: таблица правил разрешения условий ветвления (Call Guard Resolution) в телах методов AST IR (archparse) на основе ScenarioProfile и ScenarioState",
  "rules": [
    {
      "id": "BR_EXCEPTION_CATCH_ARM",
      "code": "R15",
      "description": "Плечо catch выполняется только при возникновении исключения: на штатном пути не активно",
      "enabled": true,
      "matcher": {
        "arm_exact": "catch"
      },
      "resolver": {
        "type": "constant",
        "value": false
      }
    },
    {
      "id": "BR_LAZY_LAMBDA_SUPPLIER",
      "code": "R16",
      "description": "Тело лямбды выполняется, только если хост-метод её вызывает: orElseThrow/orElseGet вызывают supplier лишь для пустого Optional",
      "enabled": true,
      "matcher": {
        "branch_type": "lambda",
        "arm_in": ["orElseThrow", "orElseGet"]
      },
      "resolver": {
        "type": "constant",
        "value": false
      }
    },
    {
      "id": "BR_EMPTY_COLLECTION_NEW_USER",
      "code": "R17",
      "description": "Цикл foreach исполняется, только если коллекция непуста. Коллекция orders пуста для вновь зарегистрированного пользователя (S4)",
      "enabled": true,
      "matcher": {
        "branch_type": "foreach",
        "arm_in": ["orders"]
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "is_new_user",
        "invert": true
      }
    },
    {
      "id": "BR_EXECUTE_REGULAR_TRAIN_MODE",
      "code": "R3",
      "description": "CancelServiceImpl / ExecuteServiceImpl: проверка наличия заказа в regular-сервисе (ts-order-other-service)",
      "enabled": true,
      "matcher": {
        "any_of": [
          {
            "condition_contains": "orderOtherResult"
          },
          {
            "method_contains": "ExecuteServiceImpl",
            "branch_id_in": ["b65", "b113"]
          }
        ]
      },
      "resolver": {
        "type": "train_mode",
        "regular_only": true,
        "high_speed_only": false,
        "default": true
      }
    },
    {
      "id": "BR_EXECUTE_HIGHSPEED_TRAIN_MODE",
      "code": "R3",
      "description": "CancelServiceImpl / ExecuteServiceImpl: проверка наличия заказа в high-speed-сервисе (ts-order-service)",
      "enabled": true,
      "matcher": {
        "condition_contains": "getStatus() == 1",
        "any_of": [
          {
            "condition_contains": "orderResult"
          },
          {
            "method_contains": "ExecuteServiceImpl",
            "branch_id_in": ["b47", "b95"]
          }
        ]
      },
      "resolver": {
        "type": "train_mode",
        "regular_only": false,
        "high_speed_only": true,
        "default": true
      }
    },
    {
      "id": "BR_REBOOK_SAME_FAMILY",
      "code": "R11",
      "description": "RebookServiceImpl#updateOrder: перебронирование всегда происходит внутри одного семейства поездов",
      "enabled": true,
      "matcher": {
        "condition_contains_all": ["tripGD", "&&"]
      },
      "resolver": {
        "type": "constant",
        "value": true
      }
    },
    {
      "id": "BR_TRIP_GD_DISPATCH",
      "code": "R3",
      "description": "InsidePaymentServiceImpl#pay: диспатч скоростных (G/D) и регулярных поездов",
      "enabled": true,
      "matcher": {
        "condition_regex": "startsWith\\(\"G\"\\)|startsWith\\(\"D\"\\)|tripGD"
      },
      "resolver": {
        "type": "train_mode",
        "regular_only": false,
        "high_speed_only": true,
        "default": true
      }
    },
    {
      "id": "BR_EXTERNAL_PAYMENT",
      "code": "R10",
      "description": "InsidePaymentServiceImpl#pay: внешний платеж при недостатке баланса (totalExpand.compareTo(money) > 0)",
      "enabled": true,
      "matcher": {
        "condition_contains": "totalExpand.compareTo(money) > 0"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_external_payment"
      }
    },
    {
      "id": "BR_CANCEL_ORDER_GATE",
      "code": "R9",
      "description": "CancelServiceImpl: проверка статуса заказа перед отменой/расчётом возврата (NOTPAID || PAID || CHANGE)",
      "enabled": true,
      "matcher": {
        "method_contains": "cancel",
        "condition_contains_all": ["OrderStatus.NOTPAID.getCode()", "OrderStatus.PAID.getCode()"]
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_refused_cancel",
        "invert": true
      }
    },
    {
      "id": "BR_CANCEL_NOTPAID_ZERO_REFUND",
      "code": "R9",
      "description": "CancelServiceImpl: одиночная проверка order.getStatus() == NOTPAID (возврат 0)",
      "enabled": true,
      "matcher": {
        "method_contains": "cancel",
        "condition_contains": "OrderStatus.NOTPAID.getCode()"
      },
      "resolver": {
        "type": "constant",
        "value": false
      }
    },
    {
      "id": "BR_REBOOK_REFUSED_COLLECTED",
      "code": "R11",
      "description": "RebookServiceImpl#rebook: статус собранного билета (COLLECTED != 1) блокирует перебронирование",
      "enabled": true,
      "matcher": {
        "method_contains": "rebook",
        "condition_contains": "getStatus() != 1"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_refused_rebook"
      }
    },
    {
      "id": "BR_ASSURANCE_OPTION",
      "code": "R6",
      "description": "PreserveServiceImpl: проверка отсутствия страховки (oti.getAssurance() == 0)",
      "enabled": true,
      "matcher": {
        "condition_contains": "getAssurance() == 0"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_assurance",
        "invert": true
      }
    },
    {
      "id": "BR_FOOD_OPTION",
      "code": "R6",
      "description": "PreserveServiceImpl: проверка наличия питания (oti.getFoodType() != 0)",
      "enabled": true,
      "matcher": {
        "condition_contains": "getFoodType() != 0"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_food"
      }
    },
    {
      "id": "BR_CONSIGN_OPTION",
      "code": "R6",
      "description": "PreserveServiceImpl: проверка наличия консигнации багажа (getConsigneeName)",
      "enabled": true,
      "matcher": {
        "condition_contains": "getConsigneeName()"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_consign"
      }
    },
    {
      "id": "BR_CONSIGN_WEIGHT_CHANGE",
      "code": "R6",
      "description": "ConsignServiceImpl: проверка изменения веса багажа (getWeight)",
      "enabled": true,
      "matcher": {
        "condition_contains": "getWeight()"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_consign_weight_change"
      }
    },
    {
      "id": "BR_VERIFY_CODE",
      "code": "R1",
      "description": "TokenServiceImpl#getToken: проверка кода верификации (!StringUtils.isEmpty(verifyCode))",
      "enabled": true,
      "matcher": {
        "condition_contains": "verifyCode"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_verification_code"
      }
    },
    {
      "id": "BR_NEW_USER",
      "code": "R1",
      "description": "UserServiceImpl#saveUser: проверка на нового пользователя (user1 == null)",
      "enabled": true,
      "matcher": {
        "condition_contains": "user1 == null"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "is_new_user"
      }
    },
    {
      "id": "BR_CONSIGN_RECORD_EXISTS",
      "code": "R6",
      "description": "ConsignServiceImpl#updateConsignRecord: при обновлении запись уже существует (!isPresent == false)",
      "enabled": true,
      "matcher": {
        "condition_regex": "consignRequest\\.getId\\(\\)\\)\\.isPresent\\(\\)|(?:findById.*isPresent)"
      },
      "resolver": {
        "type": "constant",
        "value": false
      }
    },
    {
      "id": "BR_REBOOK_PRICE_DIFFERENCE",
      "code": "R11",
      "description": "RebookServiceImpl#rebook: разница в цене при перебронировании (priceOld.compareTo(priceNew) > 0)",
      "enabled": true,
      "matcher": {
        "condition_contains": "priceOld.compareTo(priceNew) > 0"
      },
      "resolver": {
        "type": "constant",
        "value": true
      }
    },
    {
      "id": "BR_ORDER_FILTER_QUERY",
      "code": "R13",
      "description": "OrderServiceImpl / OrderOtherServiceImpl: общая фильтрация списка заказов по дате/статусу",
      "enabled": true,
      "matcher": {
        "condition_contains_all": ["isEnableStateQuery()", "isEnableBoughtDateQuery()"]
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_order_filter"
      }
    },
    {
      "id": "BR_ORDER_STATUS_QUERY",
      "code": "R13",
      "description": "OrderServiceImpl / OrderOtherServiceImpl: фильтрация списка заказов по статусу",
      "enabled": true,
      "matcher": {
        "condition_exact": "qi.isEnableStateQuery()"
      },
      "resolver": {
        "type": "profile_flag",
        "flag": "has_status_filter"
      }
    }
  ]
}

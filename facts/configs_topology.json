      "mongo_shared_contour": {
        "description": "Единый сетевой контур и общее файловое дисковое хранилище СУБД ts-server-mongo:27017 для всех 16 MongoDB-микросервисов",
        "host": "ts-server-mongo:27017",
        "db_type": "MONGODB",
        "is_terminal_sink": true,
        "participating_services": [
          "ts-station-service",
          "ts-train-service",
          "ts-route-service",
          "ts-price-service",
          "ts-config-service",
          "ts-contacts-service",
          "ts-travel-service",
          "ts-travel2-service",
          "ts-food-service",
          "ts-station-food-service",
          "ts-train-food-service",
          "ts-consign-price-service",
          "ts-consign-service",
          "ts-assurance-service",
          "ts-seat-service",
          "ts-ticket-office-service"
        ],
        "architectural_smell": "Shared Infrastructure Domain / Shared Volume",
        "adr_graph_rule": "Каждый MongoDB-микросервис инцидентен только своему узлу коллекции. Все узлы коллекций имеют флаг is_terminal_sink: true для предотвращения ложного склеивания сервисов при транзитивном замыкании."
      }
    }
  },
  "messaging_topology": {
    "broker": {
      "type": "RABBITMQ",
      "host": "rabbitmq",
      "port": 5672,
      "amqp_port": 5672,
      "management_port": 15672,
      "ports": [
        5672,
        15672
      ],
      "client_library": "spring-boot-starter-amqp"
    },
    "queues": [
      {
        "name": "email",
        "exchange": "email-exchange",
        "default_exchange": "",
        "routing_key": "email",
        "payload_class": "edu.fudan.common.util.Notification",
        "description": "Очередь email для асинхронной рассылки почтовых уведомлений о создании и оплате билетов",
        "producers": [
          {
            "service_name": "ts-order-service",
            "role": "PRODUCER",
            "relation_type": "PRODUCES_MESSAGE",
            "call_expression": "rabbitTemplate.convertAndSend(\"email\", notification)",
            "source_method": "order.service.OrderServiceImpl.createOrder / initNotification",
            "trigger": "Создание нового заказа (Ticket Preservation)",
            "payload_class": "edu.fudan.common.util.Notification"
          },
          {
            "service_name": "ts-inside-payment-service",
            "role": "PRODUCER",
            "relation_type": "PRODUCES_MESSAGE",
            "call_expression": "rabbitTemplate.convertAndSend(\"email\", notification)",
            "source_method": "inside_payment.service.InsidePaymentServiceImpl.pay",
            "trigger": "Подтверждение успешного платежа и списания средств (Inside Payment)",
            "payload_class": "edu.fudan.common.util.Notification"
          }
        ],
        "consumers": [
          {
            "service_name": "ts-notification-service",
            "role": "CONSUMER",
            "relation_type": "CONSUMES_MESSAGE",
            "handler_class": "notification.mq.RabbitReceive",
            "handler_method": "process",
            "annotation": "@RabbitListener(queues = \"email\")",
            "payload_class": "edu.fudan.common.util.Notification"
          }
        ]
      }
    ]
  }
}
